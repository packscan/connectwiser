HOST=https://your-app.onrender.com
PORT=8787
PACKSCAN_ENV=production
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Set a unique, high-entropy value in the deployment environment.
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SCOPES=read_orders,read_products,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
# Render injects this automatically from the managed PostgreSQL database.
DATABASE_URL=
SHOPIFY_BILLING_ENABLED=0
SHOPIFY_PLAN_NAME=Pro
SHOPIFY_PLAN_PRICE=79.99
SHOPIFY_PLAN_TRIAL_DAYS=14
